<Window x:Class="VeilBrowser.Views.DataCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="隐私资料中心" Width="1040" Height="680"
        MinWidth="820" MinHeight="540"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="8,10,8,22">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource ProtectionSurfaceBrush}">
                            <TextBlock Text="◆" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="13" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="隐私资料" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="LOCAL VAULT" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="◷  浏览历史" Tag="History" Click="Section_Click"
                            Style="{StaticResource SideNavButton}" />
                    <Button Content="⇩  下载记录" Tag="Downloads" Click="Section_Click"
                            Style="{StaticResource SideNavButton}" />
                    <Button Content="☆  书签收藏" Tag="Bookmarks" Click="Section_Click"
                            Style="{StaticResource SideNavButton}" />
                    <Button Content="◇  密码保险库" Tag="Passwords" Click="Section_Click"
                            Style="{StaticResource SideNavButton}" />
                    <Button Content="◉  Cookie 与网站数据" Tag="CookiesAndSiteData"
                            Click="Section_Click" Style="{StaticResource SideNavButton}" />
                    <Button Content="▤  会话恢复记录" Tag="Sessions" Click="Section_Click"
                            Style="{StaticResource SideNavButton}" />
                    <Button Content="▱  自动填充资料" Tag="Autofill" Click="Section_Click"
                            Style="{StaticResource SideNavButton}" />
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                 Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="关闭浏览器后，资料会进入 AES-256-GCM 加密容器。"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" Text="浏览历史"
                               FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="SectionHint"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource ProtectionSurfaceBrush}"
                        BorderBrush="{DynamicResource ProtectionBorderBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="本地加密" Foreground="{DynamicResource AccentBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="7" Margin="0,18,0,12">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddButton" Content="＋ 新增" Click="Add_Click" />
                    <Button x:Name="OpenButton" Content="打开" Click="Open_Click" />
                    <Button x:Name="CopyButton" Content="复制" Click="Copy_Click" />
                    <Button x:Name="DeleteButton" Content="删除所选" Click="Delete_Click" />
                    <Button x:Name="ClearButton" Content="清空此区域" Click="Clear_Click"
                            Style="{StaticResource DangerButton}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True">
                <ListView x:Name="DataList" Background="Transparent"
                          BorderThickness="0" SelectionMode="Single"
                          MouseDoubleClick="DataList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="220"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="内容" Width="340"
                                            DisplayMemberBinding="{Binding Detail}" />
                            <GridViewColumn Header="时间 / 状态" Width="170"
                                            DisplayMemberBinding="{Binding Meta}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="区域锁用于控制浏览器解锁后的再次验证；磁盘资料始终加密保存。"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="2,13,0,0" FontSize="12" />
        </Grid>
    </Grid>
</Window>
