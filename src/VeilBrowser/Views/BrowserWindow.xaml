<Window x:Class="VeilBrowser.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="隐栈浏览器" Width="1420" Height="900"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopTabsRow" Height="46" />
            <RowDefinition x:Name="NavigationRow" Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusRow" Height="26" />
        </Grid.RowDefinitions>

        <!-- Compact tab strip -->
        <Border x:Name="TopChrome"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="15,0,8,0"
                            VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7DD3FC" Offset="0" />
                                <GradientStop Color="#4ADE80" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="V" Foreground="#071016"
                                   FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="VEIL" Margin="9,0,0,0"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TabControl x:Name="Tabs" Grid.Column="1"
                            Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{StaticResource BrowserTabItemStyle}"
                            SelectionChanged="Tabs_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>

                <Button Grid.Column="2" ToolTip="新标签页 (Ctrl+T)"
                        Style="{StaticResource IconButton}" Margin="6,3,10,3"
                        Click="NewTab_Click">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons"
                               FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <!-- Navigation and tools -->
        <Border x:Name="NavigationChrome" Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,5,0">
                    <Button ToolTip="后退 (Alt+←)" Click="Back_Click"
                            Style="{StaticResource IconButton}">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button ToolTip="前进 (Alt+→)" Click="Forward_Click"
                            Style="{StaticResource IconButton}">
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button ToolTip="刷新 (F5)" Click="Reload_Click"
                            Style="{StaticResource IconButton}">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button ToolTip="主页" Click="Home_Click"
                            Style="{StaticResource IconButton}">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Height="40" CornerRadius="12"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Margin="8,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="24" Height="24" VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              ToolTip="HTTPS 优先 · 跟踪防护">
                            <Ellipse Fill="#172932" />
                            <Path Data="M 7,10 L 7,7 C 7,3 13,3 13,7 L 13,10 M 5,10 L 15,10 L 15,17 L 5,17 Z"
                                  Stroke="{StaticResource ProtectBrush}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform" Margin="4" />
                        </Grid>
                        <TextBox x:Name="AddressBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="1,0,12,0" MinHeight="38"
                                 VerticalContentAlignment="Center"
                                 FontSize="13.5"
                                 KeyDown="AddressBox_KeyDown"
                                 GotKeyboardFocus="AddressBox_GotKeyboardFocus" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="5,0,10,0">
                    <Button ToolTip="收藏当前页 (Ctrl+D)"
                            Style="{StaticResource IconButton}" Click="Bookmark_Click">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons" />
                    </Button>

                    <!-- AdGuard is deliberately visible instead of hidden in a menu. -->
                    <Border Height="38" Margin="3,0,5,0" CornerRadius="10"
                            Background="#13231A"
                            BorderBrush="#315F40" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AdGuardButton"
                                    Width="44" Height="36" MinHeight="36"
                                    Padding="0" Margin="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    ToolTip="正在加载 AdGuard…"
                                    Click="AdGuard_Click">
                                <Grid Width="26" Height="26">
                                    <Path Data="M 13,2 L 23,6 L 22,15 C 21,20 17,23 13,25 C 9,23 5,20 4,15 L 3,6 Z"
                                          Fill="{StaticResource ProtectBrush}"
                                          Stretch="Uniform" Margin="2" />
                                    <Path Data="M 8,13 L 11.5,16.5 L 18,9.5"
                                          Stroke="#07130B" StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse x:Name="AdGuardStatusDot"
                                             Width="7" Height="7"
                                             Fill="{StaticResource MutedTextBrush}"
                                             Stroke="#13231A" StrokeThickness="1.5"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom" />
                                </Grid>
                            </Button>
                            <Button x:Name="AdGuardMenuButton" Grid.Column="1"
                                    Width="23" Height="36" MinHeight="36"
                                    Padding="0" Margin="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    ToolTip="AdGuard 菜单"
                                    Click="AdGuardMenu_Click">
                                <TextBlock x:Name="AdGuardBadge" Text="…"
                                           Foreground="{StaticResource ProtectBrush}"
                                           FontSize="9" FontWeight="Bold" />
                            </Button>
                        </Grid>
                    </Border>

                    <Button ToolTip="隐私资料中心"
                            Style="{StaticResource IconButton}" Click="DataCenter_Click">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button ToolTip="安全与隐私设置"
                            Style="{StaticResource IconButton}" Click="Settings_Click">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button x:Name="LockButton" ToolTip="立即锁定并加密退出"
                            Style="{StaticResource IconButton}"
                            Foreground="{StaticResource AccentBrush}" Click="Lock_Click">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button ToolTip="更多"
                            Style="{StaticResource IconButton}"
                            Click="More_Click">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White">
            <Grid x:Name="BrowserHost" />
        </Border>

        <Grid x:Name="StatusChrome" Grid.Row="3"
              Background="{StaticResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="就绪"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="12,0"
                       FontSize="11" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0,13,0">
                <Ellipse Width="6" Height="6"
                         Fill="{StaticResource ProtectBrush}"
                         Margin="0,0,6,0" />
                <TextBlock Text="本地加密"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" FontSize="11" />
            </StackPanel>
        </Grid>

        <Border x:Name="ClosingOverlay" Grid.RowSpan="4"
                Background="#F20A0E13" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="38"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="42" Height="42" CornerRadius="14"
                            Background="#172932" HorizontalAlignment="Center">
                        <TextBlock Text="V" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ClosingText"
                               Text="正在加密浏览器资料…"
                               FontSize="19" FontWeight="SemiBold"
                               Margin="0,16,0,16"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True"
                                 Width="320" Height="4"
                                 Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="正在安全释放网页进程，请不要强制结束程序"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
