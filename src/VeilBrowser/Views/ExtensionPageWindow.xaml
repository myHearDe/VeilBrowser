<Window x:Class="VeilBrowser.Views.ExtensionPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="AdGuard"
        Width="420" Height="620"
        MinWidth="360" MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0"
                            VerticalAlignment="Center">
                    <Border Width="25" Height="25" CornerRadius="8"
                            Background="{StaticResource ProtectBrush}">
                        <TextBlock Text="✓" Foreground="#07130B"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AdGuard 控制面板" Margin="10,0,0,0"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Width="34" Height="34"
                        Margin="0,5,7,5" Padding="0"
                        Style="{StaticResource IconButton}"
                        Click="Close_Click" />
            </Grid>
            <Grid x:Name="ExtensionHost" Grid.Row="1" Background="White" />
        </Grid>
    </Border>
</Window>
