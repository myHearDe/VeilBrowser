<Window x:Class="VeilBrowser.Views.BookmarkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="保存收藏" Width="460" MinHeight="390"
        SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0"
                   Text="保存到收藏夹"
                   FontSize="22" FontWeight="SemiBold"
                   Margin="0,0,0,18" />
        <TextBlock Grid.Row="1" Text="名称" Margin="0,0,0,5" />
        <TextBox x:Name="TitleBox" Grid.Row="2"
                 MinHeight="44"
                 Padding="12,8"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,14" />
        <TextBlock Grid.Row="3" Text="网址" Margin="0,0,0,5" />
        <TextBox x:Name="UrlBox" Grid.Row="4"
                 MinHeight="44"
                 Padding="12,8"
                 VerticalContentAlignment="Center" />
        <TextBlock x:Name="ErrorText" Grid.Row="5"
                   MinHeight="20"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton"
                    Content="取消收藏"
                    Width="100"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Style="{StaticResource DangerButton}"
                    Click="Delete_Click" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Width="90" IsCancel="True" />
                <Button Content="保存" Width="90"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
