<Window x:Class="VeilBrowser.Views.BookmarkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="新增书签" Width="440" Height="320"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="新增书签" FontSize="22" FontWeight="SemiBold"
                       Margin="0,0,0,18" />
            <TextBlock Text="名称" Margin="0,0,0,5" />
            <TextBox x:Name="TitleBox" Margin="0,0,0,12" />
            <TextBlock Text="网址" Margin="0,0,0,5" />
            <TextBox x:Name="UrlBox" />
            <TextBlock x:Name="ErrorText" Foreground="#FB7185" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" IsCancel="True" />
            <Button Content="保存" Width="90" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
