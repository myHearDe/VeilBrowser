<Window x:Class="VeilBrowser.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="需要验证" Width="420" Height="270"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="此区域已上锁"
                       FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="请输入主密码继续。验证结果只在本次操作中使用。"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />
            <TextBlock x:Name="ErrorText" Foreground="#FB7185" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" IsCancel="True" />
            <Button x:Name="UnlockButton" Content="验证" Width="90"
                    Style="{StaticResource PrimaryButton}" Click="UnlockButton_Click" />
        </StackPanel>
    </Grid>
</Window>
